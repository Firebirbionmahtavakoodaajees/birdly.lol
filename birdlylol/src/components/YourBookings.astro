<section class="your-bookings" id="your-bookings">
    <span class="panel-number">02</span>
    <span class="panel-label">Your bookings</span>
    <h2>Sessions</h2>
    <div id="bookings-list"></div>
    <p id="bookings-status" aria-live="polite"></p>
</section>

<style>
    .your-bookings {
        position: relative;
        margin-top: 3rem;
        padding: 3rem 2rem 2rem;
        border: 2px solid var(--lavender);
    }

    .panel-number {
        position: absolute;
        top: 0;
        right: 0;
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border-bottom: 2px solid var(--lavender);
        border-left: 2px solid var(--lavender);
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.65rem;
    }

    .panel-label {
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    h2 {
        margin: 0.75rem 0 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--lavender);
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-style: italic;
        font-weight: 500;
    }

    #bookings-list {
        display: grid;
        gap: 8px;
    }

    .booking-row {
        display: grid;
        grid-template-columns: 1fr 140px;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .b-time {
        text-align: right;
        color: var(--lavender);
    }

    .empty {
        margin: 0;
        color: var(--lavender);
        opacity: 0.6;
        font-family: system-ui, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    #bookings-status {
        min-height: 1rem;
        margin: 1rem 0 0;
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    @media (max-width: 500px) {
        .your-bookings {
            padding: 3rem 1rem 1rem;
        }

        .booking-row {
            grid-template-columns: 1fr;
        }

        .b-time {
            text-align: left;
        }
    }
</style>

<script>
    import { supabase } from "../db/supabase";

    function initYourBookings() {
        const root = document.querySelector<HTMLElement>("#your-bookings");
        if (!root || root.dataset.ready) return;
        root.dataset.ready = "true";

        const list = root.querySelector<HTMLElement>("#bookings-list")!;
        const status = root.querySelector<HTMLElement>("#bookings-status")!;

        let reqId = 0;

        function addMinutes(time: string, mins: number) {
            const [h, m] = time.split(":").map(Number);
            const total = h * 60 + m + mins;
            return `${String(Math.floor(total / 60)).padStart(2, "0")}:${String(total % 60).padStart(2, "0")}`;
        }

        function group(rows: { date: string; time: string }[]) {
            const groups: { date: string; start: string; end: string }[] = [];
            for (const row of rows) {
                const time = row.time.slice(0, 5);
                const last = groups[groups.length - 1];
                if (last && last.date === row.date && last.end === time) {
                    last.end = addMinutes(time, 30);
                } else {
                    groups.push({ date: row.date, start: time, end: addMinutes(time, 30) });
                }
            }
            return groups;
        }

        async function load(session: any) {
            if (!session?.user) {
                list.replaceChildren();
                return;
            }

            const id = ++reqId;

            const { data, error } = await supabase
                .from("bookings")
                .select("date, time")
                // REPLACE: bookings must be linked to the logged-in user (user_id column / RLS).
                .eq("user_id", session.user.id)
                .order("date")
                .order("time");

            if (id !== reqId) return;

            list.replaceChildren();
            status.textContent = "";

            if (error) {
                status.textContent = "Unable to load bookings";
                return;
            }

            const seen = new Set<string>();
            const rows = data.filter((r) => {
                const key = r.date + r.time.slice(0, 5);
                if (seen.has(key)) return false;
                seen.add(key);
                return true;
            });

            const groups = group(rows);

            if (!groups.length) {
                const empty = document.createElement("p");
                empty.className = "empty";
                empty.textContent = "No bookings yet";
                list.append(empty);
                return;
            }

            groups.forEach((g) => {
                const row = document.createElement("div");
                row.className = "booking-row";
                const date = new Date(`${g.date}T12:00:00`).toLocaleDateString("en-FI", {
                    weekday: "short",
                    day: "numeric",
                    month: "short"
                });
                row.innerHTML = `<span class="b-date">${date}</span><span class="b-time">${g.start}–${g.end}</span>`;
                list.append(row);
            });
        }

        supabase.auth.getSession().then(({ data }) => load(data.session));

        document.addEventListener("birdly:auth", ((event: CustomEvent) => {
            if (event.detail.loggedIn) {
                supabase.auth.getSession().then(({ data }) => load(data.session));
            } else {
                list.replaceChildren();
            }
        }) as EventListener);
    }

    initYourBookings();
    document.addEventListener("astro:page-load", initYourBookings);
</script>