---
const times = Array.from({ length: 48 }, (_, i) =>
    `${String(Math.floor(i / 2)).padStart(2, "0")}:${i % 2 ? "30" : "00"}`
);

const durations = Array.from({ length: 20 }, (_, i) => ({
    minutes: (i + 1) * 30,
    label: (i + 1) * 30 === 30 ? "30 MIN" : `${(i + 1) / 2} HR`,
}));
---

<form id="booking-form" class="cal-layout">
    <div class="col">
        <header>
            <span>Date</span>
            <div class="controls">
                <button type="button" id="prev-month" aria-label="Previous month">&larr;</button>
                <span id="month-label"></span>
                <button type="button" id="next-month" aria-label="Next month">&rarr;</button>
            </div>
        </header>

        <div class="days-grid" id="days-grid">
            <span>MO</span><span>TU</span><span>WE</span><span>TH</span><span>FR</span><span>SA</span><span>SU</span>
        </div>
    </div>

    <div class="col">
        <header>
            <label for="booking-duration">Session</label>
            <span>Session</span>
            <select id="booking-duration" required>
                {durations.map((d) => (
                        <option value={d.minutes}>{d.label}</option>
                ))}
            </select>
        </header>

        <div class="time-grid">
            {times.map((t) => (
                    <button type="button" class="time-btn" data-time={t}>{t}</button>
            ))}
        </div>

        <footer>
            <span id="booking-status" aria-live="polite"></span>
            <button type="submit" id="confirm-booking" class="confirm-btn" disabled>Confirm Booking</button>
        </footer>
    </div>
</form>

<style>
    .cal-layout {
        display: grid;
        gap: 2rem;
        color: var(--lavender);
        font-family: monospace;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    @media (min-width: 768px) {
        .cal-layout {
            grid-template-columns: 1fr 1fr;
        }
    }

    .col {
        display: flex;
        flex-direction: column;
    }

    /* ── Header ── */

    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--lavender);
        padding-bottom: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .controls {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .controls button {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        padding: 0;
        background: transparent;
        border: 1px solid var(--lavender);
        color: var(--lavender);
        font-size: 0.65rem;
        border-radius: 50%;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
    }

    .controls button:hover:not(:disabled) {
        background: var(--lavender);
        color: #000;
    }

    .controls button:disabled {
        opacity: 0.25;
        cursor: not-allowed;
    }

    /* ── Select ── */

    select {
        height: 32px;
        padding: 0 0.75rem;
        background: transparent;
        border: 1px solid transparent;
        color: var(--lavender);
        font-family: monospace;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        cursor: pointer;
        border-radius: 0;
        transition: border-color 0.2s;
    }

    select:hover,
    select:focus {
        border-color: var(--lavender);
        outline: none;
    }

    /* ── Days Grid ── */

    .days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
        text-align: center;
    }

    .days-grid > span {
        padding: 0.5rem 0;
        opacity: 0.5;
        font-size: 0.65rem;
    }

    .days-grid > button {
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        background: transparent;
        border: none;
        color: var(--lavender);
        font-family: monospace;
        font-size: 0.75rem;
        cursor: pointer;
        border-radius: 50%;
        transition: background 0.15s, color 0.15s;
    }

    .days-grid > button:hover:not(:disabled):not(.empty) {
        background: rgba(255, 255, 255, 0.08);
    }

    .days-grid > button.selected {
        background: var(--lavender);
        color: #000;
        font-weight: 700;
    }

    .days-grid > button:disabled:not(.empty) {
        opacity: 0.2;
        cursor: not-allowed;
    }

    .days-grid > button.empty {
        visibility: hidden;
    }

    /* ── Time Grid ── */

    .time-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(68px, 1fr));
        gap: 4px;
        max-height: 280px;
        overflow-y: auto;
        margin-bottom: 1.5rem;
        scrollbar-width: thin;
        scrollbar-color: var(--lavender) transparent;
    }

    .time-btn {
        height: 36px;
        display: grid;
        place-items: center;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--lavender);
        font-family: monospace;
        font-size: 0.7rem;
        cursor: pointer;
        border-radius: 4px;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .time-btn:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--lavender);
    }

    .time-btn.selected {
        background: var(--lavender);
        color: #000;
        border-color: var(--lavender);
    }

    .time-btn:disabled {
        opacity: 0.15;
        cursor: not-allowed;
    }

    .time-btn.booked {
        text-decoration: line-through;
        opacity: 0.2;
        pointer-events: none;
    }

    /* ── Footer ── */

    footer {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: auto;
    }

    .confirm-btn {
        width: 100%;
        height: 44px;
        background: var(--lavender);
        border: 1px solid var(--lavender);
        color: #000;
        font-family: monospace;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        cursor: pointer;
        border-radius: 4px;
        transition: opacity 0.2s;
    }

    .confirm-btn:hover:not(:disabled) {
        opacity: 0.85;
    }

    .confirm-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    #booking-status:not(:empty) {
        text-align: center;
        padding-bottom: 0.25rem;
        font-size: 0.7rem;
        opacity: 0.8;
    }
</style>

<style is:global>
    #days-grid > button {
        aspect-ratio: 1;
        width: 100%;
        display: grid;
        place-items: center;
        background: transparent;
        border: none;
        color: var(--lavender);
        font-family: monospace;
        font-size: 0.75rem;
        cursor: pointer;
        border-radius: 50%;
        transition: background 0.15s, color 0.15s;
        position: relative;
    }

    #days-grid > button:hover:not(:disabled):not(.empty) {
        background: rgba(255, 255, 255, 1);
    }

    #days-grid > button.selected {
        background: var(--lavender);
        color: #000;
        font-weight: 700;
    }

    #days-grid > button:disabled:not(.empty) {
        opacity: 0.5;
        cursor: not-allowed;
        color: var(--lavender);
    }

    #days-grid > button:disabled:not(.empty)::before {
        content: "";
        position: absolute;
        inset: 20%;
        border: 1px solid var(--lavender);
        opacity: 0.5;
        border-radius: 0;
        transform: rotate(45deg);
        pointer-events: none;
    }

    #days-grid > button:disabled:not(.empty)::after {
        content: "";
        position: absolute;
        width: 70%;
        height: 1px;
        background: var(--lavender);
        opacity: 0.5;
        pointer-events: none;
    }

    #days-grid > button.empty {
        visibility: hidden;
    }
</style>

<script>
    import { supabase } from "../db/supabase";

    function initCalendar() {
        const form = document.querySelector("#booking-form");
        if (!(form instanceof HTMLFormElement) || form.dataset.ready) return;
        form.dataset.ready = "true";

        const els = {
            month: form.querySelector("#month-label")!,
            status: form.querySelector("#booking-status")!,
            confirm: form.querySelector("#confirm-booking") as HTMLButtonElement,
            duration: form.querySelector("#booking-duration") as HTMLSelectElement,
            prev: form.querySelector("#prev-month") as HTMLButtonElement,
            next: form.querySelector("#next-month") as HTMLButtonElement,
            days: form.querySelector("#days-grid")!,
            times: [...form.querySelectorAll("[data-time]")] as HTMLButtonElement[],
        };

        const today = new Date();
        const todayStr = formatDate(today);
        let currMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        let activeDate = todayStr;
        let activeTime = "";
        let booked = new Set<string>();
        let dayBtns: HTMLButtonElement[] = [];

        function formatDate(d: Date) {
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        }

        function renderMonth() {
            const y = currMonth.getFullYear();
            const m = currMonth.getMonth();
            const offset = (new Date(y, m, 1).getDay() + 6) % 7;
            const total = new Date(y, m + 1, 0).getDate();

            els.month.textContent = currMonth.toLocaleDateString("en-US", {
                month: "short",
                year: "numeric",
            });

            els.prev.disabled =
                currMonth.getTime() ===
                new Date(today.getFullYear(), today.getMonth(), 1).getTime();

            dayBtns.forEach((b) => b.remove());
            dayBtns = [];

            for (let i = 0; i < 42; i++) {
                const day = i - offset + 1;
                const btn = document.createElement("button");
                btn.type = "button";

                if (day < 1 || day > total) {
                    btn.className = "empty";
                    btn.disabled = true;
                } else {
                    const val = formatDate(new Date(y, m, day));
                    btn.textContent = String(day);
                    btn.disabled = val < todayStr;
                    if (val === activeDate) btn.classList.add("selected");

                    btn.addEventListener("click", () => {
                        activeDate = val;
                        renderMonth();
                        loadBookings();
                    });
                }

                dayBtns.push(btn);
                els.days.appendChild(btn);
            }
        }

        function updateTimes() {
            const slots = Number(els.duration.value) / 30;
            const minsNow = today.getHours() * 60 + today.getMinutes();
            const isToday = activeDate === todayStr;

            els.times.forEach((btn, i) => {
                const [h, m] = btn.dataset.time!.split(":").map(Number);
                const range = els.times.slice(i, i + slots);
                btn.disabled =
                    (isToday && h * 60 + m <= minsNow) ||
                    range.length < slots ||
                    range.some((b) => booked.has(b.dataset.time!));

                btn.classList.remove("selected");
                btn.classList.toggle("booked", booked.has(btn.dataset.time!));
            });

            activeTime = "";
            els.confirm.disabled = true;
        }

        async function loadBookings() {
            els.status.textContent = "";
            const { data, error } = await supabase
                .from("bookings")
                .select("time")
                .eq("date", activeDate);

            if (error) {
                els.status.textContent = "Error loading times";
                return;
            }

            booked = new Set((data || []).map((d) => d.time.slice(0, 5)));
            updateTimes();
        }

        els.times.forEach((btn) =>
            btn.addEventListener("click", () => {
                if (btn.disabled) return;
                els.times.forEach((b) => b.classList.remove("selected"));
                btn.classList.add("selected");
                activeTime = btn.dataset.time!;
                els.confirm.disabled = false;
            })
        );

        els.duration.addEventListener("change", updateTimes);

        els.prev.addEventListener("click", () => {
            currMonth = new Date(
                currMonth.getFullYear(),
                currMonth.getMonth() - 1,
                1
            );
            activeDate =
                formatDate(currMonth) < todayStr
                    ? todayStr
                    : formatDate(currMonth);
            renderMonth();
            loadBookings();
        });

        els.next.addEventListener("click", () => {
            currMonth = new Date(
                currMonth.getFullYear(),
                currMonth.getMonth() + 1,
                1
            );
            activeDate = formatDate(currMonth);
            renderMonth();
            loadBookings();
        });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (!activeTime) return;

            els.confirm.disabled = true;
            els.status.textContent = "Booking...";

            const {
                data: { session },
            } = await supabase.auth.getSession();

            if (!session) {
                els.status.textContent = "Login required";
                return;
            }

            const slots = Number(els.duration.value) / 30;
            const startIdx = els.times.findIndex(
                (b) => b.dataset.time === activeTime
            );
            const rows = els.times
                .slice(startIdx, startIdx + slots)
                .map((b) => ({
                    date: activeDate,
                    time: b.dataset.time,
                    user_id: session.user.id,
                }));

            const { error } = await supabase.from("bookings").insert(rows);

            if (error) {
                await loadBookings();
                els.status.textContent =
                    error.code === "23505" ? "Slot taken" : "Booking failed";
                return;
            }

            els.status.textContent = "Confirmed";
            setTimeout(() => (window.location.href = "/account"), 1200);
        });

        renderMonth();
        loadBookings();
    }

    initCalendar();
    document.addEventListener("astro:page-load", initCalendar);
</script>