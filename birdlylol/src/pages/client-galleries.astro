---
import Layout from "../layouts/Layout.astro";

import lapland from "../assets/clients/lapland.jpg";
import concert from "../assets/clients/concert.jpg";
import wanhat from "../assets/clients/wanhat.jpg";
import carmeet from "../assets/clients/carmeet.jpg";
import dances from "../assets/clients/dances.jpg";
import celebration from "../assets/clients/celebration.jpg";

// Edit client names and links here.
const galleries = [
    { name: "Lapland", url: "https://birdly.pixieset.com/lappiandnorway2025/", image: lapland },
    { name: "Concert", url: "https://birdly.pixieset.com/maykvappu2025ruikkutuikku/", image: concert },
    { name: "Wanhat", url: "https://birdly.pixieset.com/wanhattanssit/", image: wanhat },
    { name: "Carmeet", url: "https://birdly.pixieset.com/vantaacruising2024/", image: carmeet },
    { name: "Dances", url: "https://birdly31.pixieset.com/ysitanssit2026/", image: dances },
    { name: "Celebration", url: "https://birdly31.pixieset.com/mayk30vjuhla/", image: celebration }
];
---

<Layout title="Client Galleries | Birdly">
    <section class="section">
        <div class="container">
            <span class="section-label">02 — Private Access</span>
            <h1>Client Galleries</h1>

            <div class="grid-4">
                {galleries.map((gallery) => (
                        <article class="card">
                            <img src={gallery.image.src} alt={gallery.name} style="width:100%;aspect-ratio:3/2;object-fit:cover;" />
                            <h2>{gallery.name}</h2>
                            <a href={gallery.url} target="_blank" rel="noreferrer">Open Gallery</a>
                        </article>
                ))}
            </div>
        </div>
    </section>
</Layout>

<style>
    h2 {
        margin: 1rem 0 0.5rem;
        font-size: 1.25rem;
    }
</style>