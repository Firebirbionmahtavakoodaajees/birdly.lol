---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Birdly">
    <section class="section">
        <div class="container">
            <span class="section-label">04 — Say Hello</span>
            <h1>Contact</h1>

            <p class="about">
                Miks sä katot tänne ees viel
            </p>

            <ul class="list">
                <li><strong>Email:</strong> your@email.com</li>
                <li><strong>Phone:</strong> +358 XX XXX XXXX</li>
                <li><strong>Instagram:</strong> @yourhandle</li>
                <li><strong>WhatsApp:</strong> +358 XX XXX XXXX</li>
            </ul>
        </div>
    </section>
</Layout>

<style>
    .about {
        max-width: 48rem;
        margin: 0;
        line-height: 1.7;
        font-size: 1.1rem;
    }
</style>