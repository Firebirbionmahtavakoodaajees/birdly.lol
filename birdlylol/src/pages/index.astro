---
import Layout from "../layouts/Layout.astro";
import heroImage from "../assets/hero.jpg";

import Gallery from "../components/Gallery.astro";
const showcase = Object.values(
	import.meta.glob<{ default: ImageMetadata }>("../assets/showcase/*.{jpg,jpeg,png,webp}", { eager: true })
);
---


<Layout title="Birdly">
	<section class="hero">
		<div class="hero-box">
			<img src={heroImage.src} alt="Birdly photography" class="hero-image" />
			<div class="hero-content">
				<img src="/favicon.png" alt="Birdly" class="hero-logo" />
				<span class="hero-label">Helsinki · Photography</span>
				<h1 class="hero-title">Birdly</h1>
			</div>
			<a href="#showcase" class="scroll-cue" aria-label="Scroll to showcase">
  				<span class="cue-circle">
    				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      					<line x1="12" y1="5" x2="12" y2="19"></line>
      					<polyline points="5 12 12 19 19 12"></polyline>
    				</svg>
				</span>
			</a>
		</div>
	</section>

	<section id="showcase" class="intro">
		<p class="intro-description">Meet the only budget photographers in Helsinki!</p>
		<p class="intro-main">Quality • Value, from only <span class="price-badge"> 25€ </span>!</p>
	</section>

	<div class="divider">
		<span></span><span></span><span></span><span></span><span></span>
	</div>

	<section class="section">
		<div class="container">
			<span class="section-label">01 — Featured Work</span>
			<h1>Showcase</h1>
			<h3>Pictures from our recent photoshoot!</h3>

			<Gallery images={showcase} />
		</div>
	</section>

	<div class="divider">
		<span></span><span></span><span></span><span></span><span></span>
	</div>

	<section class="all-photos">
		<a href="/photos" class="all-photos-link">View all photos</a>
	</section>

</Layout>

<style>
	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 2rem;
		transform: translateX(-50%);
		z-index: 2;
		color: var(--white);
		text-decoration: none;
		animation: bounce 1.8s ease-in-out infinite;
	}

	.cue-circle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: 2px solid var(--lavender);
		background: transparent;
	}

	@keyframes bounce {
		0%, 100% { transform: translateX(-50%) translateY(0); }
		50%      { transform: translateX(-50%) translateY(10px); }
	}

	@keyframes bounce-mobile {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(10px); }
	}

	.hero-logo {
		height: 80px;
		width: auto;
		display: block;
		margin-bottom: 1.5rem;
	}

	.hero {
		padding: 0;
		position: relative;
	}

	.hero-box {
		width: 100%;
		height: calc(100vh - 72px);
		background: #000;
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		padding: 3rem;
		overflow: hidden;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		color: var(--white);
	}

	.hero-label {
		display: block;
		font-family: system-ui, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--lavender);
		margin-bottom: 1rem;
	}

	.hero-title {
		font-size: clamp(4rem, 15vw, 12rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 0.85;
		margin: 0;
		font-style: italic;
	}

	.price-badge {
		background: var(--lavender);
		border-radius: 16px;
		padding: 2px 12px 2px 6px;
		display: inline-block;
		margin-left: 4px;
		margin-right: 4px;
	}

	.intro {
		padding: 4rem 2rem;
		text-align: center;
	}

	.intro-description {
		font-family: system-ui, sans-serif;
		font-size: clamp(0.25rem, 1.5vw, 2rem);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--lavender);
		margin: 0 0 1.5rem;
		font-weight: 600;
	}

	.intro-main {
		font-family: "Fraunces", serif;
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.02em;
		margin: 0;
		font-style: italic;
	}

	.all-photos {
		padding: 4rem 2rem;
		text-align: center;
	}

	.all-photos-link {
		display: inline-block;
		padding: 1rem 2.5rem;
		border: 2px solid var(--lavender);
		color: inherit;
		text-decoration: none;
		font-family: system-ui, sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		transition: background 0.25s;
	}

	.all-photos-link:hover {
		background: var(--lavender);
	}

	@media (max-width: 640px) {
		.hero-box {
			height: calc(100vh - 64px);
			padding: 1.5rem;
		}

		.scroll-cue {
			left: auto;
			right: 1.5rem;
			transform: none;
			animation: bounce-mobile 1.8s ease-in-out infinite;
		}
	}
</style>