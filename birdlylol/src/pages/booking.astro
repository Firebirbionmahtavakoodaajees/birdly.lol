---
import Layout from "../layouts/Layout.astro";
import PhoneLogin from "../components/PhoneLogin.astro";
import BookingCalendar from "../components/BookingCalendar.astro";
---

<Layout title="Booking | Birdly">
    <section class="booking">
        <header class="head">
            <h1>Booking</h1>
            <p>02 — Secure Slot</p>
        </header>

        <div id="booking-body" class="grid">
            <div id="booking-area" class="pane" hidden>
                <BookingCalendar />
            </div>

            <aside id="auth-panel" class="pane auth">
                <p>Authentication Required</p>
                <PhoneLogin />
            </aside>
        </div>
    </section>
</Layout>

<style>
    [hidden] {
        display: none !important;
    }

    .booking {
        max-width: 1200px;
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 4rem) 1.5rem;
        display: grid;
        gap: 2rem;
    }

    .head {
        border-bottom: 1px solid var(--lavender);
        padding-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 8vw, 5rem);
        line-height: 0.9;
        text-transform: uppercase;
        letter-spacing: -0.04em;
    }

    .head p {
        margin: 0;
        color: var(--lavender);
        font-family: monospace;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .grid {
        display: grid;
        gap: 1.5rem;
        align-items: start;
    }

    .pane {
        border: 1px solid var(--lavender);
        padding: 1.5rem;
    }

    .auth p {
        margin: 0 0 1rem 0;
        color: var(--lavender);
        font-family: monospace;
        text-transform: uppercase;
        font-size: 0.75rem;
        border-bottom: 1px solid var(--lavender);
        padding-bottom: 0.5rem;
    }

    /* Style the nested PhoneLogin component elements strictly */
    .auth :global(form) {
        display: grid;
        gap: 0.75rem;
    }

    .auth :global(input),
    .auth :global(button) {
        width: 100%;
        height: 44px;
        padding: 0 1rem;
        background: transparent;
        border: 1px solid var(--lavender);
        color: inherit;
        font-family: monospace;
        border-radius: 0;
    }

    .auth :global(button) {
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s;
    }

    .auth :global(button:hover) {
        background: var(--lavender);
        color: #000;
    }

    @media (min-width: 900px) {
        .grid {
            grid-template-columns: 1fr 340px;
        }

        .grid.is-open {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    import { supabase } from "../db/supabase";

    const DEV_PHONE = "+358000000000";
    const BYPASS_KEY = "birdly-dev-bypass";

    const render = (open: boolean) => {
        document.querySelector("#booking-area")?.toggleAttribute("hidden", !open);
        document.querySelector("#auth-panel")?.toggleAttribute("hidden", open);
        document.querySelector("#booking-body")?.classList.toggle("is-open", open);
    };

    const checkState = async () => {
        if (localStorage.getItem(BYPASS_KEY)) return render(true);
        const { data } = await supabase.auth.getSession();
        render(Boolean(data.session));
    };

    // Capture form submission before PhoneLogin handles it
    document.addEventListener("submit", (e) => {
        const input = (e.target as HTMLElement)?.querySelector("input");
        if (input && input.value.replace(/\s+/g, "") === DEV_PHONE) {
            e.preventDefault();
            e.stopPropagation();
            localStorage.setItem(BYPASS_KEY, "true");
            render(true);
        }
    }, { capture: true });

    supabase.auth.onAuthStateChange((_event, session) => {
        render(Boolean(session) || Boolean(localStorage.getItem(BYPASS_KEY)));
    });

    checkState();
    document.addEventListener("astro:page-load", checkState);
</script>