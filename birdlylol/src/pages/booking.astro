---
import Layout from "../layouts/Layout.astro";
import PhoneLogin from "../components/PhoneLogin.astro";

const times = Array.from({ length: 48 }, (_, index) =>
    `${String(Math.floor(index / 2)).padStart(2, "0")}:${index % 2 ? "30" : "00"}`
);

const durations = Array.from({ length: 20 }, (_, index) => {
    const minutes = (index + 1) * 30;
    const hours = minutes / 60;
    return {
        minutes,
        label: minutes === 30 ? "30 minutes" : `${hours} hour${hours === 1 ? "" : "s"}`
    };
});
---

<Layout title="Booking | Birdly">
    <section class="section">
        <div class="container">
            <span class="section-label">02 — Client Booking</span>
            <h1>Booking</h1>

            <div id="booking-area" class="booking-layout" hidden>
                <form id="booking-form">
                    <span class="panel-number">01</span>

                    <div class="calendar-panel">
                        <header class="calendar-header">
                            <button id="previous-month" type="button" aria-label="Previous month">←</button>
                            <h2 id="month-label"></h2>
                            <button id="next-month" type="button" aria-label="Next month">→</button>
                        </header>

                        <div class="weekdays">
                            <span>MON</span><span>TUE</span><span>WED</span><span>THU</span>
                            <span>FRI</span><span>SAT</span><span>SUN</span>
                        </div>

                        <div class="days">
                            {Array.from({ length: 42 }, () => <button type="button" disabled></button>)}
                        </div>
                    </div>

                    <div class="fields">
                        <label class="time-field">
                            Start time
                            <select id="booking-time" required>
                                <option value="">Select a time</option>
                                {times.map((time) => (
                                        <option value={time} data-time={time}>{time}</option>
                                ))}
                            </select>
                        </label>

                        <label>
                            Duration
                            <select id="booking-duration" required>
                                {durations.map(({ minutes, label }) => (
                                        <option value={minutes}>{label}</option>
                                ))}
                            </select>
                        </label>
                    </div>

                    <p class="selected-date" id="selected-date"></p>

                    <button id="confirm-booking" type="submit" disabled>Confirm booking</button>
                    <p id="booking-status" aria-live="polite"></p>
                </form>
            </div>

            <p id="login-prompt" class="login-prompt">Please log in to book.</p>
            <PhoneLogin />
        </div>
    </section>
</Layout>

<style>
    [hidden] { display: none !important; }

    .login-prompt {
        margin-top: 2rem;
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    .booking-layout { margin-top: 3rem; }

    #booking-form {
        position: relative;
        border: 2px solid var(--lavender);
        padding: 3rem 2rem 2rem;
        display: grid;
        gap: 12px;
    }

    .panel-number {
        position: absolute;
        top: 0;
        right: 0;
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border-bottom: 2px solid var(--lavender);
        border-left: 2px solid var(--lavender);
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.65rem;
    }

    .calendar-panel {
        max-width: 340px;
        margin: 0 auto;
    }

    .calendar-header {
        display: grid;
        grid-template-columns: 48px 1fr 48px;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .calendar-header h2 {
        margin: 0;
        font-size: clamp(1.25rem, 3vw, 2rem);
        font-style: italic;
        font-weight: 500;
        text-align: center;
    }

    .calendar-header button {
        width: 40px;
        height: 40px;
        color: var(--lavender);
    }

    .weekdays, .days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .weekdays {
        margin-bottom: 4px;
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.55rem;
        letter-spacing: 0.1em;
        text-align: center;
    }

    .days button {
        aspect-ratio: 1;
        border: 1px solid var(--lavender);
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 0.8rem;
        cursor: pointer;
    }

    .days button.empty { visibility: hidden; }
    .days button.selected { outline: 2px solid var(--lavender); outline-offset: 2px; }
    .days button:disabled:not(.empty) { opacity: 0.3; cursor: not-allowed; }

    .fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    label {
        display: grid;
        gap: 0.75rem;
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    select, button {
        width: 100%;
        min-height: 52px;
        border: 2px solid var(--lavender);
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: inherit;
    }

    select {
        padding: 0 1rem;
        color: var(--lavender);
    }

    button {
        padding: 0 1rem;
        font-family: system-ui, sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        cursor: pointer;
    }

    button:hover:not(:disabled) { background: var(--lavender); }
    button:disabled { opacity: 0.35; cursor: not-allowed; }

    .selected-date {
        margin: 0;
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    #booking-status {
        min-height: 1rem;
        margin: 0;
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    @media (max-width: 500px) {
        #booking-form { padding: 3rem 1rem 1rem; }
        .fields { grid-template-columns: 1fr; }
        .calendar-panel { max-width: 100%; }
    }
</style>

<script>
    import { supabase } from "../db/supabase";

    function initBooking() {
        const form = document.querySelector<HTMLFormElement>("#booking-form");
        if (!form || form.dataset.ready) return;
        form.dataset.ready = "true";

        const monthLabel = document.querySelector<HTMLElement>("#month-label")!;
        const dayButtons = [...document.querySelectorAll<HTMLButtonElement>(".days button")];
        const timeInput = document.querySelector<HTMLSelectElement>("#booking-time")!;
        const durationInput = document.querySelector<HTMLSelectElement>("#booking-duration")!;
        const confirm = document.querySelector<HTMLButtonElement>("#confirm-booking")!;
        const status = document.querySelector<HTMLElement>("#booking-status")!;
        const selectedDateLabel = document.querySelector<HTMLElement>("#selected-date")!;
        const options = [...timeInput.querySelectorAll<HTMLOptionElement>("[data-time]")];

        const today = new Date();
        let displayedMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        let selectedDate = formatDate(today);
        let bookedSet = new Set<string>();

        function formatDate(date: Date) {
            return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
        }

        function renderCalendar() {
            const year = displayedMonth.getFullYear();
            const month = displayedMonth.getMonth();
            const offset = (new Date(year, month, 1).getDay() + 6) % 7;
            const totalDays = new Date(year, month + 1, 0).getDate();

            monthLabel.textContent = displayedMonth.toLocaleDateString("en-FI", {
                month: "long",
                year: "numeric"
            });

            dayButtons.forEach((button, index) => {
                const day = index - offset + 1;
                const empty = day < 1 || day > totalDays;
                button.className = empty ? "empty" : "";
                button.textContent = empty ? "" : String(day);
                button.disabled = empty;
                if (empty) return;

                const value = formatDate(new Date(year, month, day));
                button.dataset.date = value;
                button.disabled = value < formatDate(today);
                button.classList.toggle("selected", value === selectedDate);
            });
        }

        function updateOptions() {
            const slotCount = Number(durationInput.value) / 30;
            const now = new Date();
            const currentMinutes = now.getHours() * 60 + now.getMinutes();
            const isToday = selectedDate === formatDate(now);

            options.forEach((option, index) => {
                const [h, m] = option.dataset.time!.split(":").map(Number);
                const passed = isToday && h * 60 + m <= currentMinutes;
                const range = options.slice(index, index + slotCount);
                const unavailable =
                    range.length < slotCount ||
                    range.some((slot) => bookedSet.has(slot.dataset.time!));

                option.disabled = passed || unavailable;
            });

            if (timeInput.selectedOptions[0]?.disabled) timeInput.value = "";
            confirm.disabled = !timeInput.value;
        }

        async function loadBookings() {
            status.textContent = "";
            timeInput.value = "";
            confirm.disabled = true;

            selectedDateLabel.textContent = new Date(`${selectedDate}T12:00:00`)
                .toLocaleDateString("en-FI", { day: "numeric", month: "long", year: "numeric" });

            const { data, error } = await supabase
                .from("bookings")
                .select("time")
                .eq("date", selectedDate);

            if (error) {
                status.textContent = "Unable to load times";
                return;
            }

            bookedSet = new Set(data.map(({ time }) => time.slice(0, 5)));
            updateOptions();
        }

        dayButtons.forEach((button) =>
            button.addEventListener("click", () => {
                selectedDate = button.dataset.date!;
                renderCalendar();
                loadBookings();
            })
        );

        timeInput.addEventListener("change", () => {
            confirm.disabled = !timeInput.value;
        });

        durationInput.addEventListener("change", () => {
            timeInput.value = "";
            updateOptions();
        });

        document.querySelector("#previous-month")!.addEventListener("click", () => {
            displayedMonth = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth() - 1, 1);
            renderCalendar();
        });

        document.querySelector("#next-month")!.addEventListener("click", () => {
            displayedMonth = new Date(displayedMonth.getFullYear(), displayedMonth.getMonth() + 1, 1);
            renderCalendar();
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!timeInput.value) return;

            confirm.disabled = true;
            status.textContent = "Booking...";

            const { data: { session } } = await supabase.auth.getSession();
            const slotCount = Number(durationInput.value) / 30;
            const startIndex = options.findIndex((o) => o.value === timeInput.value);

            const booking = options
                .slice(startIndex, startIndex + slotCount)
                .map((o) => ({
                    date: selectedDate,
                    time: o.value,
                    // REPLACE: if your bookings table stores user_id, include it (or set via RLS default).
                    user_id: session?.user?.id
                }));

            const { error } = await supabase.from("bookings").insert(booking);

            if (error) {
                status.textContent =
                    error.code === "23505" ? "This time is already booked" : "Unable to complete booking";
                confirm.disabled = false;
                return;
            }

            status.textContent = "Booking confirmed";
            setTimeout(() => { window.location.href = "/account"; }, 1200);
        });

        renderCalendar();
        loadBookings();
    }

    initBooking();
    document.addEventListener("astro:page-load", initBooking);

    const prompt = document.querySelector<HTMLElement>("#login-prompt");
    const area = document.querySelector<HTMLElement>("#booking-area");

    function gate(loggedIn: boolean) {
        if (area) area.hidden = !loggedIn;
        if (prompt) prompt.hidden = loggedIn;
    }

    supabase.auth.getSession().then(({ data }) => gate(Boolean(data.session)));
    document.addEventListener("birdly:auth", ((e: CustomEvent) => gate(e.detail.loggedIn)) as EventListener);
</script>