---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pricing | Birdly">
    <section class="section">
        <div class="container">
            <span class="section-label">03 — Investment</span>
            <h1>Pricing</h1>

            <div class="grid-3">
                <article class="card">
                    <h2>Basic</h2>
                    <p>Placeholder text for the Basic tier. You can fill in session details, pricing, and delivery later.</p>
                </article>

                <article class="card accent">
                    <h2>Standard</h2>
                    <p>Placeholder text for the Standard tier. You can fill in session details, pricing, and delivery later.</p>
                </article>

                <article class="card">
                    <h2>Premium</h2>
                    <p>Placeholder text for the Premium tier. You can fill in session details, pricing, and delivery later.</p>
                </article>
            </div>
        </div>
    </section>
</Layout>

<style>
    h2 {
        margin: 0 0 1rem;
        font-size: 1.5rem;
    }

    p {
        margin: 0;
        line-height: 1.6;
    }

    .accent {
        border: 2px solid var(--lavender);
    }
</style>