---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pricing | Birdly">
    <section class="section">
        <div class="container">
            <span class="section-label">03 — Investment</span>
            <h1>Pricing</h1>

            <div class="grid-3">
                <article class="card">
                    <h2>Basic | 50€</h2>
                    <p>We don't charge by hour. Get results with a minimal budget.</p>
                    <br/>
                    <p>We do:</p>
                    <p>- 25 pictures fully edited</p>
                    <br/>
                    <p>- Fully customizable requests, such as:</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*What will be captured</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*Where will you post? (Instagram square, Vertical, Horizontal)</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*The amount of specific pictures</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*Any special requests can be requested!</p>
                    <br/>
                    <p>- No bullshit. We come, we work.</p>
                </article>

                <article class="card accent">
                    <span class="bestvalue">★ Best Value</span>
                    <h2>Standard | 100€</h2>
                    <p>We don't charge by hour. Get results + video on a  budget.</p>
                    <br/>
                    <p>We do:</p>
                    <p>- 40 pictures fully edited</p>
                    <br>
                    <p>- 1 promo video of your choosing</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*EG Short form</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*EG Short ad</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*EG Promotional video</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*EG Youtube ad</p>
                    <br/>
                    <p>- Fully customizable requests, such as:</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*What will be captured</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*Where will you post? (Instagram square, Vertical, Horizontal)</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*The amount of specific pictures</p>
                    <p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*Any special requests can be requested!</p>
                    <br/>
                    <p>- No bullshit. We come, we work.</p>
                </article>

                <article class="card premium">
                    <h2>Custom | ~25€ an hour</h2>
                    <p>Contact us!</p>
                    <p>Tell us your offer!</p>
                    <h3>We do discounts!</h3>
                </article>
            </div>
        </div>
    </section>
</Layout>

<style>
    h2 {
        margin: 0 0 1rem;
        font-size: 1.5rem;
    }

    p {
        margin: 0;
        line-height: 1.6;
    }

    .accent {
        border: 2px solid var(--lavender);
    }

    .premium {
        position: relative;
        border: 2px solid var(--black);
        background: var(--white);
    }

    .premium::before {
        content: "";
        position: absolute;
        inset: -8px;
        border: 2px solid var(--lavender);
        pointer-events: none;
        z-index: -1;
    }

    .accent {
        border: 2px solid var(--lavender);
        position: relative;
    }

    .bestvalue {
        position: absolute;
        top: -12px;
        right: 12px;
        background: var(--black);
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        padding: 4px 10px;
        font-weight: 600;
    }

</style>