---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pricing | Birdly">
    <section class="section">
        <div class="container">
            <span class="section-label">03 — Investment</span>
            <h1>Pricing</h1>

            <div class="grid-3">
                <article class="card">
                    <h2>Basic</h2>
                    <p>Contact us! (~10€)</p>
                </article>

                <article class="card accent">
                    <span class="bestvalue">★ Best Value</span>
                    <h2>Standard</h2>
                    <p>Contact us! (~30€)</p>
                </article>

                <article class="card premium">
                    <h2>Premium</h2>
                    <p>Contact us! (~75€)</p>
                </article>
            </div>
        </div>
    </section>
</Layout>

<style>
    h2 {
        margin: 0 0 1rem;
        font-size: 1.5rem;
    }

    p {
        margin: 0;
        line-height: 1.6;
    }

    .accent {
        border: 2px solid var(--lavender);
    }

    .premium {
        position: relative;
        border: 2px solid var(--black);
        background: var(--white);
    }

    .premium::before {
        content: "";
        position: absolute;
        inset: -8px;
        border: 2px solid var(--lavender);
        pointer-events: none;
        z-index: -1;
    }

    .accent {
        border: 2px solid var(--lavender);
        position: relative;
    }

    .bestvalue {
        position: absolute;
        top: -12px;
        right: 12px;
        background: var(--black);
        color: var(--lavender);
        font-family: system-ui, sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        padding: 4px 10px;
        font-weight: 600;
    }

</style>